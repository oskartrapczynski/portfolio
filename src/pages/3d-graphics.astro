---
import Layout from '../components/Layout.astro'
import { SmoothScroll } from '../components/SmoothScroll'
import { Navigation } from '../components/Navigation'
import { Graphics3D } from '../components/Graphics3D/Graphics3D'
import { Footer } from '../components/Footer'
import { ACCENT } from '../components/Graphics3D/graphics3d.data'
---

<Layout title="3D Graphics - Oskar T.T">
  <!-- Płynny scroll (Lenis). Usuń tę linię, by wyłączyć. -->
  <SmoothScroll client:load />

  <!-- --hero-accent i --nav-hover na <main>, żeby border i hover navbara oraz stopka też były pomarańczowe -->
  <main
    class="relative overflow-x-clip bg-background"
    style={`--hero-accent: ${ACCENT}; --nav-hover: ${ACCENT}`}
  >
    <Navigation client:load />
    <Graphics3D client:load />
    <Footer client:load />
  </main>
</Layout>
