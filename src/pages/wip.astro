---
import Layout from '../components/Layout.astro'
---

<Layout title="Work in progress - Oskar T.T">
  <main
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-4 text-center"
  >
    <div class="grid-bg absolute inset-0 opacity-20"></div>

    <div class="relative z-10 flex flex-col items-center gap-6">
      <p class="font-mono text-sm tracking-[0.3em] text-gray-500 uppercase">
        {'< coming soon >'}
      </p>

      <h1 class="text-neon-cyan font-mono text-5xl font-bold md:text-7xl">
        Work in progress
      </h1>

      <p class="max-w-md font-mono text-base text-neon-blue md:text-lg">
        This section is still under construction. Check back soon.
      </p>

      <a
        href="/#hero"
        class="mt-4 rounded-full border border-neon-cyan/40 px-6 py-2 font-mono text-neon-cyan transition-colors duration-300 hover:bg-neon-cyan/10"
      >
        ← Back to homepage
      </a>
    </div>
  </main>
</Layout>
